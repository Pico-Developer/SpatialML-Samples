    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_JS_SCRIPTING_PICO",
      "inputs": [
        {
          "name": "det",
          "tensor": "post_det"
        }
      ],
      "outputs": [
        {
          "name": "uv",
          "tensor": "image_point"
        }
      ],
      "attrs": [
        "var det;\nvar uv;\nuv[0] = Math.round((det[0] + det[2]) * 0.5);\nuv[1] = Math.round((det[1] + det[3]) * 0.5);\n"
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_UV_TO_3D_IN_CAM_SPACE_PICO",
      "inputs": [
        {
          "tensor": "image_point"
        },
        {
          "tensor": "vst_timestamp"
        },
        {
