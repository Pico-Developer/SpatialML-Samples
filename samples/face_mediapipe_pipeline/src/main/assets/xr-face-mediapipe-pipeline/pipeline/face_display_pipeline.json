        },
        {
          "tensor": "vst_right_image"
        }
      ],
      "outputs": [
        {
          "tensor": "point_xyz_array"
        }
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_JS_SCRIPTING_PICO",
      "inputs": [
        {
          "name": "point",
          "tensor": "point_xyz_array"
        }
      ],
      "outputs": [
        {
          "name": "translation",
          "tensor": "point_xyz_scaled"
        }
      ],
      "attrs": [
        "var point;\nvar translation;\ntranslation[0] = point[0];\ntranslation[1] = -point[1];\ntranslation[2] = point[2] + 0.03;\n"
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_JS_SCRIPTING_PICO",
      "inputs": [
        {
          "name": "det",
          "tensor": "post_det"
        },
        {
          "name": "point",
          "tensor": "point_xyz_array"
        }
      ],
      "outputs": [
        {
          "name": "scale",
          "tensor": "frame_scale"
        }
      ],
      "attrs": [
        "var det;\nvar point;\nvar scale;\nvar depth = Math.max(Math.abs(point[2]), 0.1);\nvar widthMeters = Math.max(det[2] - det[0], 1.0) * depth / 368.85532;\nvar heightMeters = Math.max(det[3] - det[1], 1.0) * depth / 276.44321;\nscale[0] = widthMeters / 10.0;\nscale[1] = heightMeters / 10.0;\nscale[2] = 0.002;\n"
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_MAKE_TRANSFORM_MAT_PICO",
      "inputs": [
        {
          "tensor": "rotation"
        },
        {
          "tensor": "point_xyz_scaled"
        },
        {
          "tensor": "frame_scale"
        }
      ],
      "outputs": [
        {
          "tensor": "local_pose"
        }
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_JS_SCRIPTING_PICO",
      "inputs": [
        {
          "name": "det",
          "tensor": "post_det"
        }
      ],
      "outputs": [
        {
          "name": "text",
          "tensor": "confidence_text"
        }
      ],
      "attrs": [
        "var det;\nvar text;\nvar percent = Math.max(0, Math.min(100, Math.round(det[4] * 100.0)));\ntext[0] = percent >= 100 ? 49 : (percent >= 10 ? 48 + Math.floor(percent / 10) : 48 + percent);\ntext[1] = percent >= 100 ? 48 : (percent >= 10 ? 48 + (percent % 10) : 37);\ntext[2] = percent >= 100 ? 48 : (percent >= 10 ? 37 : 32);\ntext[3] = percent >= 100 ? 37 : 32;\n"
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_CAMERA_SPACE_TO_WORLD_PICO",
      "inputs": [
        {
          "tensor": "vst_timestamp"
        }
      ],
      "outputs": [
        {
          "tensor": "right_eye_transform"
        },
        {
          "tensor": "left_eye_transform"
        }
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_ARITHMETIC_COMPOSE_PICO",
      "inputs": [
        {
          "tensor": "left_eye_transform"
        },
        {
          "tensor": "local_pose"
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null
      ],
      "outputs": [
        {
          "tensor": "frame_pose"
        }
      ],
      "attrs": [
        "({0} * {1})"
      ]
    },
    {
      "type": "XR_SECURE_MR_OPERATOR_TYPE_CUSTOMIZED_COMPARE_PICO",
      "inputs": [
